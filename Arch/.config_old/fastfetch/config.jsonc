{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": "arch",
    "display": {
        "separator": " ›  "
    },
    "modules": [
	"break",
        {
            "type": "os",
            "key": "OS  ",
            "keyColor": "blue",  // = color1
        },
        {
            "type": "kernel",
            "key": "KER ",
            "keyColor": "blue",
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": "PKG ",
            "keyColor": "blue", //36  
        },
        {
            "type": "shell",
            "key": "SH  ",
            "keyColor": "blue", 
        },
        {
            "type": "terminal",
            "key": "TER ",
            "keyColor": "blue", 
        },
        {
            "type": "wm",
            "key": "WM  ",
            "keyColor": "blue", 
        },
        {
            "type": "cpu",
            "key": "CPU ",
            "keyColor": "blue",
        },
        {
            "type": "gpu",
            "key": "GPU ",
            "keyColor": "blue",
        },
        {
            "type": "memory",
            "key": "Mem ",
            "keyColor": "blue",
        },
        {
            "type": "disk",
            "key": "Disk",
            "keyColor": "blue",
        },
        {
            "type": "uptime",
            "key": "UP  ",
            "keyColor": "blue",
        },


        "break",
    ]
}
